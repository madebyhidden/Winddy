<Window x:Class="Winddy.Views.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Winddy.Services"
        Title="{l:Tr EditItem}" Width="520" Height="420" MinWidth="380" MinHeight="300"
        WindowStartupLocation="CenterScreen" Icon="/Assets/Winddy.ico" Topmost="True"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Foreground}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <DockPanel Margin="18">
        <Grid DockPanel.Dock="Top" x:Name="PinFields" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{l:Tr Alias}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="TitleBox" Grid.Column="1" Padding="4,3" />
            <TextBlock Grid.Column="2" Text="{l:Tr Key}" VerticalAlignment="Center" Margin="14,0,8,0" />
            <ComboBox x:Name="KeyBox" Grid.Column="3" MinWidth="60" />
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{l:Tr Content}" Margin="0,0,0,4" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="WarningText" Text="{l:Tr RichTextEditWarning}" Foreground="{DynamicResource SecondaryForeground}" FontSize="12" Margin="0,0,0,8" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:Tr Cancel}" MinWidth="90" Padding="10,4" IsCancel="True" />
                <Button Content="{l:Tr SaveButton}" MinWidth="90" Padding="10,4" Margin="8,0,0,0" Click="Save_Click" ToolTip="Ctrl+Enter" />
            </StackPanel>
        </StackPanel>
        <TextBox x:Name="ContentBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Mono, Consolas" Padding="6,4" />
    </DockPanel>
</Window>
