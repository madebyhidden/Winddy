<ui:FluentWindow x:Class="Winddy.Views.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:l="clr-namespace:Winddy.Services"
        Title="{l:Tr EditItemTitle}" Width="560" Height="460" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{l:Tr EditItemTitle}" ShowMinimize="False" ShowMaximize="False" />
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Content="{l:Tr SaveButton}" Appearance="Primary" HorizontalAlignment="Stretch" Click="Save_Click" ToolTip="Ctrl+Enter" />
                <ui:Button Grid.Column="2" Content="{l:Tr Cancel}" HorizontalAlignment="Stretch" IsCancel="True" />
            </Grid>
        </Border>
        <DockPanel Margin="24,4,24,18">
            <Grid DockPanel.Dock="Top" x:Name="PinFields" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:Tr Alias}" Margin="0,0,0,6" />
                    <ui:TextBox x:Name="TitleBox" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Tr Key}" Margin="0,0,0,6" />
                    <ComboBox x:Name="KeyBox" MinWidth="0" />
                </StackPanel>
            </Grid>
            <TextBlock DockPanel.Dock="Top" Text="{l:Tr Content}" Margin="0,0,0,6" />
            <TextBlock DockPanel.Dock="Bottom" x:Name="WarningText" Text="{l:Tr RichTextEditWarning}" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="Collapsed" />
            <TextBox x:Name="ContentBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" FontFamily="{StaticResource MonoFont}" FontSize="13" />
        </DockPanel>
    </DockPanel>
</ui:FluentWindow>
