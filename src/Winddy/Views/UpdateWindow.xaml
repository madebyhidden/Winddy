<ui:FluentWindow x:Class="Winddy.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:l="clr-namespace:Winddy.Services"
        Title="{l:Tr UpdateTitle}" Width="560" Height="460" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{l:Tr UpdateTitle}" ShowMinimize="False" ShowMaximize="False" />
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="24,18">
            <StackPanel>
                <ProgressBar x:Name="Progress" Height="4" Visibility="Collapsed" Margin="0,0,0,14" Maximum="1" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12" />
                <DockPanel>
                    <ui:Button x:Name="SkipButton" Content="{l:Tr SkipVersion}" Appearance="Transparent" Click="Skip_Click" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button x:Name="LaterButton" Content="{l:Tr RemindLater}" IsCancel="True" Click="Later_Click" />
                        <ui:Button x:Name="InstallButton" Content="{l:Tr InstallUpdate}" Appearance="Primary" Margin="8,0,0,0" IsDefault="True" Click="Install_Click" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
        <DockPanel Margin="24,4,24,20">
            <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/Winddy.ico" Width="56" Height="56" VerticalAlignment="Top" Margin="0,4,18,0" />
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{l:Tr UpdateHeadline}" FontWeight="SemiBold" FontSize="20" TextWrapping="Wrap" />
                <TextBlock x:Name="VersionsText" Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}" FontSize="13" />
                <TextBlock Text="{l:Tr ReleaseNotes}" FontWeight="SemiBold" Margin="0,16,0,6" />
            </StackPanel>
            <Border Style="{StaticResource Card}" Padding="0" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="13" />
                </ScrollViewer>
            </Border>
        </DockPanel>
    </DockPanel>
</ui:FluentWindow>
