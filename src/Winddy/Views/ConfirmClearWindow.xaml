<ui:FluentWindow x:Class="Winddy.Views.ConfirmClearWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:l="clr-namespace:Winddy.Services"
        Title="Winddy" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- Laid out like a Windows 11 ContentDialog -->
    <StackPanel>
        <ui:TitleBar Title="Winddy" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="24,4,24,24">
            <TextBlock Text="{l:Tr ClearAlertMessage}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{l:Tr ClearAlertComment}" Margin="0,12,0,0" TextWrapping="Wrap" />
            <CheckBox x:Name="DontAsk" Content="{l:Tr DontAskAgain}" Margin="0,16,0,0" />
        </StackPanel>
        <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Content="{l:Tr Clear}" Appearance="Primary" HorizontalAlignment="Stretch" IsDefault="True" Click="Confirm_Click" />
                <ui:Button Grid.Column="2" Content="{l:Tr Cancel}" HorizontalAlignment="Stretch" IsCancel="True" Click="Cancel_Click" />
            </Grid>
        </Border>
    </StackPanel>
</ui:FluentWindow>
