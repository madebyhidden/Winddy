<Window x:Class="Winddy.Views.ConfirmClearWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Winddy.Services"
        Title="Winddy" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Foreground}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <StackPanel Margin="24,20" MaxWidth="380">
        <TextBlock Text="{l:Tr ClearAlertMessage}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
        <TextBlock Text="{l:Tr ClearAlertComment}" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap" />
        <CheckBox x:Name="DontAsk" Content="{l:Tr DontAskAgain}" Margin="0,16,0,0" Foreground="{DynamicResource Foreground}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{l:Tr Cancel}" MinWidth="90" Padding="10,4" IsCancel="True" Click="Cancel_Click" />
            <Button Content="{l:Tr Clear}" MinWidth="90" Padding="10,4" Margin="8,0,0,0" IsDefault="True" Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</Window>
