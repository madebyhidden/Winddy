<ui:FluentWindow x:Class="Winddy.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:l="clr-namespace:Winddy.Services"
        xmlns:c="clr-namespace:Winddy.Controls"
        Title="{l:Tr SettingsTitle}" Width="1000" Height="720" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ui:FluentWindow.Resources>
        <Style x:Key="Page" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="0,0,0,32" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinWidth" Value="220" />
        </Style>
        <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="120" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <!-- Row of an editable list inside a card -->
        <DataTemplate x:Key="ListRow">
            <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Click="RemoveEntry_Click" ToolTip="{l:Tr Remove}" />
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="52,0,0,0" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{l:Tr SettingsTitle}" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/Winddy.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <DockPanel Margin="16,8,8,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,0,20">
                    <Image Source="pack://application:,,,/Assets/Winddy.ico" Width="56" Height="56" />
                    <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="Winddy" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" FontSize="13" />
                    </StackPanel>
                </StackPanel>
                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="NavList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Tag="GeneralPage">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" /><TextBlock Text="{l:Tr General}" Margin="14,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="StoragePage">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xEDA2;" /><TextBlock Text="{l:Tr Storage}" Margin="14,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="AppearancePage">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE790;" /><TextBlock Text="{l:Tr Appearance}" Margin="14,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="PinsPage">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE718;" /><TextBlock Text="{l:Tr Pins}" Margin="14,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="IgnorePage">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xED1A;" /><TextBlock Text="{l:Tr Ignore}" Margin="14,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="AdvancedPage">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE90F;" /><TextBlock Text="{l:Tr Advanced}" Margin="14,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>

            <!-- Pages -->
            <ScrollViewer Grid.Column="1" x:Name="PageScroller" VerticalScrollBarVisibility="Auto" Padding="0,0,28,0" Margin="12,0,0,0">
                <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,18" />

                    <!-- General -->
                    <StackPanel x:Name="GeneralPage" Style="{StaticResource Page}">
                        <c:SettingsCard Glyph="&#xE7E8;" Header="{l:Tr LaunchAtLogin}">
                            <ui:ToggleSwitch x:Name="LaunchAtLoginBox" Click="LaunchAtLogin_Click" />
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xE895;" Header="{l:Tr CheckForUpdates}" Description="{Binding Source={x:Static l:Updater.CurrentVersion}, StringFormat='Winddy {0}'}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{l:Tr CheckNow}" Margin="0,0,16,0" Click="CheckNow_Click" />
                                <ui:ToggleSwitch IsChecked="{Binding CheckForUpdates}" />
                            </StackPanel>
                        </c:SettingsCard>

                        <TextBlock Text="{l:Tr ShortcutsSection}" Style="{StaticResource SectionHeader}" />
                        <c:SettingsCard Glyph="&#xE765;" Header="{l:Tr OpenHotkeyHeader}" Description="{l:Tr OpenHotkeyDescription}">
                            <c:HotkeyBox x:Name="OpenHotkeyBox" RequireModifier="True" Hotkey="{Binding OpenHotkey, UpdateSourceTrigger=PropertyChanged}" />
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xE718;" Header="{l:Tr PinHotkeyHeader}">
                            <c:HotkeyBox Hotkey="{Binding PinHotkey, UpdateSourceTrigger=PropertyChanged}" />
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xE74D;" Header="{l:Tr DeleteHotkeyHeader}">
                            <c:HotkeyBox Hotkey="{Binding DeleteHotkey, UpdateSourceTrigger=PropertyChanged}" />
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xE8A1;" Header="{l:Tr PreviewHotkeyHeader}">
                            <c:HotkeyBox Hotkey="{Binding PreviewHotkey, UpdateSourceTrigger=PropertyChanged}" />
                        </c:SettingsCard>

                        <TextBlock Text="{l:Tr BehaviorSection}" Style="{StaticResource SectionHeader}" />
                        <c:SettingsCard Glyph="&#xE721;" Header="{l:Tr SearchHeader}">
                            <ComboBox x:Name="SearchModeBox" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding SearchMode}" />
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xE77F;" Header="{l:Tr PasteAutomatically}" Description="{l:Tr PasteAutomaticallyDescription}">
                            <ui:ToggleSwitch IsChecked="{Binding PasteByDefault}" />
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xE8D2;" Header="{l:Tr PasteWithoutFormatting}">
                            <ui:ToggleSwitch IsChecked="{Binding RemoveFormattingByDefault}" />
                        </c:SettingsCard>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="20" Margin="2,0,18,0" VerticalAlignment="Top" />
                                <TextBlock x:Name="ModifiersText" Style="{StaticResource Caption}" FontSize="13" LineHeight="20" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{l:Tr NotificationsSection}" Style="{StaticResource SectionHeader}" />
                        <c:SettingsCard Glyph="&#xEA8F;" Header="{l:Tr ShowNotifications}">
                            <ui:ToggleSwitch IsChecked="{Binding ShowNotifications}" />
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xE767;" Header="{l:Tr PlaySounds}">
                            <ui:ToggleSwitch IsChecked="{Binding PlaySounds}" />
                        </c:SettingsCard>

                        <TextBlock Text="{l:Tr LanguageSection}" Style="{StaticResource SectionHeader}" />
                        <c:SettingsCard Glyph="&#xE774;" Header="{l:Tr LanguageHeader}" x:Name="LanguageCard">
                            <ComboBox x:Name="LanguageBox" SelectedValuePath="Value" DisplayMemberPath="Label" SelectionChanged="LanguageBox_SelectionChanged" />
                        </c:SettingsCard>
                    </StackPanel>

                    <!-- Storage -->
                    <StackPanel x:Name="StoragePage" Style="{StaticResource Page}">
                        <TextBlock Text="{l:Tr SaveDescription}" Style="{StaticResource SectionHeader}" Margin="1,0,0,8" />
                        <c:SettingsCard Glyph="&#xE8B7;" Header="{l:Tr Files}">
                            <ui:ToggleSwitch IsChecked="{Binding SaveFiles}" />
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xEB9F;" Header="{l:Tr Images}">
                            <ui:ToggleSwitch IsChecked="{Binding SaveImages}" />
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xE8C1;" Header="{l:Tr Text}">
                            <ui:ToggleSwitch IsChecked="{Binding SaveText}" />
                        </c:SettingsCard>

                        <TextBlock Text="{l:Tr HistorySection}" Style="{StaticResource SectionHeader}" />
                        <c:SettingsCard Glyph="&#xE81C;" Header="{l:Tr SizeHeader}" Description="{l:Tr SizeTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DiskSizeText" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <TextBox Style="{StaticResource NumberBox}" Text="{Binding HistorySize, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xE8CB;" Header="{l:Tr SortByHeader}">
                            <ComboBox x:Name="SortByBox" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding SortBy}" />
                        </c:SettingsCard>
                    </StackPanel>

                    <!-- Appearance -->
                    <StackPanel x:Name="AppearancePage" Style="{StaticResource Page}">
                        <c:SettingsCard Glyph="&#xE8A7;" Header="{l:Tr PopupAtHeader}" Description="{l:Tr PopupAtDescription}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{l:Tr ResetPosition}" Margin="0,0,12,0" Click="ResetPosition_Click" />
                                <ComboBox x:Name="PopupPositionBox" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding PopupPosition}" />
                            </StackPanel>
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xE718;" Header="{l:Tr PinToHeader}">
                            <ComboBox x:Name="PinToBox" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding PinTo}" />
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xE7E6;" Header="{l:Tr HighlightHeader}">
                            <ComboBox x:Name="HighlightBox" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding HighlightMatch}" />
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xEB9F;" Header="{l:Tr ImageHeightHeader}" Description="{l:Tr ImageHeightDescription}">
                            <TextBox Style="{StaticResource NumberBox}" Text="{Binding ImageMaxHeight, UpdateSourceTrigger=PropertyChanged}" />
                        </c:SettingsCard>

                        <TextBlock Text="{l:Tr PreviewSection}" Style="{StaticResource SectionHeader}" />
                        <c:SettingsCard Glyph="&#xE8A1;" Header="{l:Tr OpenPreviewAutomatically}">
                            <ui:ToggleSwitch IsChecked="{Binding OpenPreviewAutomatically}" />
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xE916;" Header="{l:Tr PreviewDelayHeader}" Description="{l:Tr PreviewDelayDescription}">
                            <TextBox Style="{StaticResource NumberBox}" Text="{Binding PreviewDelay, UpdateSourceTrigger=PropertyChanged}" />
                        </c:SettingsCard>

                        <TextBlock Text="{l:Tr WindowSection}" Style="{StaticResource SectionHeader}" />
                        <c:SettingsCard Glyph="&#xE721;" Header="{l:Tr ShowSearch}">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="SearchVisibilityBox" MinWidth="170" Margin="0,0,16,0" SelectedValuePath="Value" DisplayMemberPath="Label"
                                          SelectedValue="{Binding SearchVisibility}" IsEnabled="{Binding ShowSearch}" />
                                <ui:ToggleSwitch IsChecked="{Binding ShowSearch}" />
                            </StackPanel>
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xE8D2;" Header="{l:Tr ShowTitle}">
                            <ui:ToggleSwitch IsChecked="{Binding ShowTitle}" />
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xE71D;" Header="{l:Tr ShowApplicationIcons}">
                            <ui:ToggleSwitch IsChecked="{Binding ShowApplicationIcons}" />
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xE790;" Header="{l:Tr ShowHexColorSwatch}" Description="{l:Tr ShowHexColorSwatchDescription}">
                            <ui:ToggleSwitch IsChecked="{Binding ShowHexColorSwatch}" />
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xE75D;" Header="{l:Tr ShowSpecialSymbols}" Description="{l:Tr ShowSpecialSymbolsDescription}">
                            <ui:ToggleSwitch IsChecked="{Binding ShowSpecialSymbols}" />
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xE700;" Header="{l:Tr ShowFooter}" Description="{l:Tr FooterWarning}">
                            <ui:ToggleSwitch IsChecked="{Binding ShowFooter}" />
                        </c:SettingsCard>

                        <TextBlock Text="{l:Tr TraySection}" Style="{StaticResource SectionHeader}" />
                        <c:SettingsCard Glyph="&#xE7C4;" Header="{l:Tr ShowInTray}">
                            <ui:ToggleSwitch IsChecked="{Binding ShowInTray}" />
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xE8C8;" Header="{l:Tr ShowRecentCopyInTray}" IsEnabled="{Binding ShowInTray}">
                            <ui:ToggleSwitch IsChecked="{Binding ShowRecentCopyInTray}" />
                        </c:SettingsCard>
                    </StackPanel>

                    <!-- Pins -->
                    <StackPanel x:Name="PinsPage" Style="{StaticResource Page}">
                        <TextBlock Text="{l:Tr PinDescription}" Style="{StaticResource Caption}" FontSize="13" Margin="1,0,0,14" />
                        <TextBlock x:Name="NoPinsText" Text="{l:Tr NoPins}" Style="{StaticResource Caption}" FontSize="13" Margin="1,8" />
                        <ItemsControl x:Name="PinsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding AvailablePins}" SelectedItem="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                      MinWidth="0" ToolTip="{l:Tr Key}" />
                                            <ui:TextBox Grid.Column="1" Margin="8,0,0,0" PlaceholderText="{l:Tr Alias}" Text="{Binding Title, UpdateSourceTrigger=LostFocus}" />
                                            <ui:TextBox Grid.Column="2" Margin="8,0,0,0" PlaceholderText="{l:Tr Content}" Text="{Binding Content, UpdateSourceTrigger=LostFocus}"
                                                        IsEnabled="{Binding IsEditable}" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                                                <Button Style="{StaticResource IconButton}" Content="&#xE70E;" Click="PinUp_Click" />
                                                <Button Style="{StaticResource IconButton}" Content="&#xE70D;" Click="PinDown_Click" />
                                                <Button Style="{StaticResource IconButton}" Content="&#xE77A;" Click="Unpin_Click" ToolTip="{l:Tr Unpin}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Ignore -->
                    <StackPanel x:Name="IgnorePage" Style="{StaticResource Page}">
                        <TextBlock Text="{l:Tr ApplicationsTab}" Style="{StaticResource SectionHeader}" Margin="1,0,0,8" />
                        <c:SettingsCard Glyph="&#xE71D;" Header="{l:Tr IgnoreAllExceptListed}">
                            <ui:ToggleSwitch IsChecked="{Binding IgnoreAllAppsExceptListed}" />
                        </c:SettingsCard>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xED1A;" FontSize="20" Margin="2,0,18,0" />
                                    <TextBlock Text="{l:Tr IgnoredAppsDescription}" Style="{StaticResource Caption}" FontSize="13" />
                                </DockPanel>
                                <ItemsControl x:Name="AppsList" ItemTemplate="{StaticResource ListRow}" />
                                <DockPanel Margin="52,8,0,0">
                                    <Button DockPanel.Dock="Right" Content="{l:Tr Browse}" Margin="8,0,0,0" Click="BrowseApp_Click" />
                                    <Button DockPanel.Dock="Right" Content="{l:Tr Add}" Margin="8,0,0,0" Click="AddApp_Click" />
                                    <ui:TextBox x:Name="AppInput" PlaceholderText="KeePass.exe" KeyDown="AppInput_KeyDown" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{l:Tr FormatsTab}" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" FontSize="20" Margin="2,0,18,0" />
                                    <TextBlock Text="{l:Tr IgnoredFormatsDescription}" Style="{StaticResource Caption}" FontSize="13" />
                                </DockPanel>
                                <ItemsControl x:Name="FormatsList" ItemTemplate="{StaticResource ListRow}" />
                                <DockPanel Margin="52,8,0,0">
                                    <Button DockPanel.Dock="Right" Content="{l:Tr Reset}" Margin="8,0,0,0" Click="ResetFormats_Click" />
                                    <Button DockPanel.Dock="Right" Content="{l:Tr Add}" Margin="8,0,0,0" Click="AddFormat_Click" />
                                    <ui:TextBox x:Name="FormatInput" PlaceholderText="Clipboard Viewer Ignore" KeyDown="FormatInput_KeyDown" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{l:Tr RegexpTab}" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE943;" FontSize="20" Margin="2,0,18,0" />
                                    <TextBlock Text="{l:Tr IgnoredRegexpDescription}" Style="{StaticResource Caption}" FontSize="13" />
                                </DockPanel>
                                <ItemsControl x:Name="RegexList" ItemTemplate="{StaticResource ListRow}" FontFamily="{StaticResource MonoFont}" />
                                <DockPanel Margin="52,8,0,0">
                                    <Button DockPanel.Dock="Right" Content="{l:Tr Add}" Margin="8,0,0,0" Click="AddRegex_Click" />
                                    <ui:TextBox x:Name="RegexInput" PlaceholderText="^\d{4} \d{4} \d{4} \d{4}$" FontFamily="{StaticResource MonoFont}" KeyDown="RegexInput_KeyDown" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Advanced -->
                    <StackPanel x:Name="AdvancedPage" Style="{StaticResource Page}">
                        <c:SettingsCard Glyph="&#xE769;" Header="{l:Tr TurnOff}" Description="{l:Tr TurnOffDescription}">
                            <ui:ToggleSwitch IsChecked="{Binding IgnoreEvents}" />
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xE894;" Header="{l:Tr ClearOnQuit}" Description="{l:Tr ClearOnQuitTooltip}">
                            <ui:ToggleSwitch IsChecked="{Binding ClearOnQuit}" />
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xE77F;" Header="{l:Tr ClearSystemClipboard}" Description="{l:Tr ClearSystemClipboardTooltip}">
                            <ui:ToggleSwitch IsChecked="{Binding ClearSystemClipboard}" />
                        </c:SettingsCard>
                        <c:SettingsCard Glyph="&#xE756;" Header="{l:Tr CommandLineHeader}" Description="{l:Tr CommandLineDescription}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
