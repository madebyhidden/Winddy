<Window x:Class="Winddy.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Winddy.Services"
        xmlns:c="clr-namespace:Winddy.Controls"
        Title="Winddy"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        SizeToContent="Height"
        MinWidth="260" MinHeight="80"
        Width="450"
        Background="{DynamicResource WindowBackground}"
        BorderBrush="{DynamicResource WindowBorder}"
        BorderThickness="1"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Foreground="{DynamicResource Foreground}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="FooterRow" TargetType="Border">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectionForeground}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShortcutText" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title + search -->
        <Grid x:Name="Header" Grid.Row="0" Margin="10,8,10,6" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Text="{l:Tr AppTitle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,10,0" />
            <Border Grid.Column="1" Background="{DynamicResource SearchBackground}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Opacity="0.55" VerticalAlignment="Center" Margin="8,0,2,0" />
                    <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{l:Tr SearchPlaceholder}" Opacity="0.45" VerticalAlignment="Center" Margin="6,0" IsHitTestVisible="False" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" Padding="4,4"
                             Foreground="{DynamicResource Foreground}" CaretBrush="{DynamicResource Foreground}"
                             VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                    <Button x:Name="ClearSearchButton" Grid.Column="2" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                            Background="Transparent" BorderThickness="0" Padding="8,0" Opacity="0.6" Focusable="False" Cursor="Hand"
                            Foreground="{DynamicResource Foreground}" Visibility="Collapsed" Click="ClearSearchButton_Click" />
                </Grid>
            </Border>
        </Grid>

        <!-- Paste stack banner -->
        <Border x:Name="StackBanner" Grid.Row="1" VerticalAlignment="Top" Margin="5,0,5,4" Padding="10,5" CornerRadius="5"
                Background="{DynamicResource Separator}" Visibility="Collapsed" Panel.ZIndex="1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:Tr StopPasteStack}" Padding="8,1" Click="StopStack_Click" Focusable="False" />
                <TextBlock x:Name="StackText" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- History list -->
        <ListBox x:Name="List" Grid.Row="1" Focusable="False" BorderThickness="0" Background="Transparent" Padding="0"
                 Foreground="{DynamicResource Foreground}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Border x:Name="Row" Margin="5,0" Padding="8,3" CornerRadius="5" Background="Transparent"
                                MouseMove="Row_MouseMove" MouseLeftButtonUp="Row_MouseLeftButtonUp" ToolTipService.InitialShowDelay="1500">
                            <Border.ContextMenu>
                                <ContextMenu Opened="RowMenu_Opened">
                                    <MenuItem x:Name="PinMenuItem" Header="{l:Tr Pin}" Click="PinMenuItem_Click" />
                                    <MenuItem Header="{l:Tr EditItem}" Click="EditMenuItem_Click" />
                                    <MenuItem Header="{l:Tr Delete}" Click="DeleteMenuItem_Click" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding AppIcon}" Visibility="{Binding AppIconVisibility}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{Binding Swatch}" Visibility="{Binding SwatchVisibility}" Width="12" Height="12" CornerRadius="3"
                                        BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <c:HighlightTextBlock x:Name="TitleBlock" Grid.Column="2" SourceText="{Binding Title}" Ranges="{Binding Ranges}"
                                                      Visibility="{Binding TitleVisibility}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Padding="0,1" />
                                <Image Grid.Column="2" Source="{Binding Thumbnail}" Visibility="{Binding ImageVisibility}" MaxHeight="{Binding ImageMaxHeight}"
                                       HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,2" />
                                <Border Grid.Column="3" Visibility="{Binding BadgeVisibility}" Background="{DynamicResource SelectionForeground}"
                                        CornerRadius="8" MinWidth="16" Height="16" Padding="4,0" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SelectionBackground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="ShortcutBlock" Grid.Column="3" Text="{Binding Shortcut}" Opacity="0.55" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Height="1" Margin="10,4" Background="{DynamicResource Separator}" Visibility="{Binding SeparatorVisibility}" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBackground}" />
                            <Setter TargetName="Row" Property="TextElement.Foreground" Value="{DynamicResource SelectionForeground}" />
                            <Setter TargetName="ShortcutBlock" Property="Opacity" Value="0.8" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Footer -->
        <StackPanel x:Name="Footer" Grid.Row="2" Margin="0,0,0,6">
            <Border Height="1" Margin="10,4,10,4" Background="{DynamicResource Separator}" />
            <Border Style="{StaticResource FooterRow}" MouseLeftButtonUp="Clear_Click" x:Name="ClearRow" ToolTip="{l:Tr ClearTooltip}">
                <DockPanel>
                    <TextBlock x:Name="ClearShortcut" DockPanel.Dock="Right" Style="{StaticResource ShortcutText}" Text="Ctrl+Alt+Backspace" />
                    <TextBlock x:Name="ClearLabel" Text="{l:Tr Clear}" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource FooterRow}" MouseLeftButtonUp="Preferences_Click">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource ShortcutText}" Text="Ctrl+," />
                    <TextBlock Text="{l:Tr Preferences}" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource FooterRow}" MouseLeftButtonUp="About_Click" ToolTip="{l:Tr AboutTooltip}">
                <TextBlock Text="{l:Tr About}" />
            </Border>
            <Border Style="{StaticResource FooterRow}" MouseLeftButtonUp="Quit_Click" ToolTip="{l:Tr QuitTooltip}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource ShortcutText}" Text="Ctrl+Q" />
                    <TextBlock Text="{l:Tr Quit}" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Preview -->
        <Popup x:Name="PreviewPopup" Grid.RowSpan="3" PlacementTarget="{Binding ElementName=Root}" Placement="Right"
               HorizontalOffset="6" AllowsTransparency="True" StaysOpen="True" Focusable="False">
            <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="12" MaxWidth="520" MinWidth="220">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-4,-4,6">
                        <StackPanel.Resources>
                            <Style TargetType="Button">
                                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Width" Value="28" />
                                <Setter Property="Height" Value="26" />
                                <Setter Property="Margin" Value="2,0,0,0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </StackPanel.Resources>
                        <Button x:Name="CopyTextButton" Content="&#xE8C8;" Click="CopyText_Click" />
                        <Button x:Name="PinButton" Content="&#xE718;" Click="PinButton_Click" />
                        <Button x:Name="EditButton" Content="&#xE70F;" Click="EditButton_Click" />
                        <Button x:Name="DeleteButton" Content="&#xE74D;" Click="DeleteButton_Click" />
                    </StackPanel>
                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                       Foreground="{DynamicResource Foreground}" />
                            <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="400" HorizontalAlignment="Left" />
                        </Grid>
                    </ScrollViewer>
                    <Border Height="1" Margin="0,10" Background="{DynamicResource Separator}" />
                    <TextBlock x:Name="PreviewInfo" Foreground="{DynamicResource SecondaryForeground}" FontSize="12" LineHeight="18" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
