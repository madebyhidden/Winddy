<Window x:Class="Winddy.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Winddy.Services"
        Title="{l:Tr About}" SizeToContent="Height" Width="400" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Icon="/Assets/Winddy.ico"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Foreground}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <StackPanel Margin="28,24">
        <Image Source="/Assets/Winddy.ico" Width="72" Height="72" HorizontalAlignment="Center" />
        <TextBlock Text="Winddy" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
        <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryForeground}" Margin="0,2,0,0" />
        <TextBlock Text="{l:Tr AboutDescription}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0" />
        <TextBlock Text="{l:Tr AboutCredits}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" Foreground="{DynamicResource SecondaryForeground}" />
        <TextBlock HorizontalAlignment="Center" Margin="0,12,0,0">
            <Hyperlink NavigateUri="https://github.com/p0deje/Maccy" RequestNavigate="Link_RequestNavigate">github.com/p0deje/Maccy</Hyperlink>
        </TextBlock>
        <Button Content="{l:Tr Close}" HorizontalAlignment="Center" MinWidth="90" Padding="10,4" Margin="0,20,0,0" IsCancel="True" IsDefault="True" Click="Close_Click" />
    </StackPanel>
</Window>
