<ui:FluentWindow x:Class="Winddy.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:l="clr-namespace:Winddy.Services"
        Title="{l:Tr About}" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel>
        <ui:TitleBar Title="{l:Tr About}" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="32,8,32,28">
            <Image Source="pack://application:,,,/Assets/Winddy.ico" Width="80" Height="80" HorizontalAlignment="Center" />
            <TextBlock Text="Winddy" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
            <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0" />
            <TextBlock Text="{l:Tr AboutDescription}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,18,0,0" />
            <TextBlock Text="{l:Tr AboutCredits}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0" Style="{StaticResource Caption}" FontSize="13" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <ui:Button Content="GitHub" Margin="0,0,8,0" Click="Repo_Click" />
                <ui:Button Content="Maccy" Click="Maccy_Click" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
