<Application x:Class="Winddy.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Brushes are replaced at startup by Theme.Apply according to the Windows light/dark setting. -->
        <SolidColorBrush x:Key="WindowBackground" Color="#F7F7F8" />
        <SolidColorBrush x:Key="WindowBorder" Color="#D0D0D4" />
        <SolidColorBrush x:Key="Foreground" Color="#1C1C1E" />
        <SolidColorBrush x:Key="SecondaryForeground" Color="#6E6E73" />
        <SolidColorBrush x:Key="SelectionBackground" Color="#2563EB" />
        <SolidColorBrush x:Key="SelectionForeground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SearchBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Separator" Color="#E0E0E4" />
        <SolidColorBrush x:Key="HighlightColor" Color="#D97706" />
    </Application.Resources>
</Application>
