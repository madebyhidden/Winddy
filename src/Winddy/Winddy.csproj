<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Winddy</AssemblyName>
    <RootNamespace>Winddy</RootNamespace>
    <ApplicationIcon>Assets\Winddy.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Winddy</Product>
    <Description>Lightweight clipboard manager for Windows</Description>
    <Copyright>MIT License</Copyright>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Winddy.ico" />
    <Resource Include="Assets\WinddyPaused.ico" />
    <Resource Include="Assets\Knock.wav" />
    <Resource Include="Assets\Write.wav" />
  </ItemGroup>

</Project>
